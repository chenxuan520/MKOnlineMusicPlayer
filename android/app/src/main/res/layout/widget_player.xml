<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面挂件 4x2：左封面 + 右（歌名/歌手/进度条 + 圆形控制按钮行） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp">

    <!-- 左：专辑封面 -->
    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_cover_bg"
        android:contentDescription="@string/widget_cover_desc" />

    <!-- 右：信息 + 控制区 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="10dp">

        <!-- 上：歌名/歌手（点击打开 App） -->
        <LinearLayout
            android:id="@+id/widget_info"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 细进度条 -->
            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>

        <!-- 下：圆形控制按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_btn_circle"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_prev"
                android:contentDescription="@string/widget_prev" />

            <ImageButton
                android:id="@+id/widget_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/widget_btn_circle"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_play"
                android:contentDescription="@string/widget_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_btn_circle"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_next"
                android:contentDescription="@string/widget_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
